{
  "functions": { "api/index.js": { "includeFiles": "{public,src}/**", "maxDuration": 60 } },
  "redirects": [
    {
      "source": "/((?!api/|api$|mcp|openapi\\.json).*)",
      "has": [{ "type": "host", "value": "nuance-hub-sand.vercel.app" }],
      "destination": "https://nuancehub.app/$1",
      "permanent": true
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index?__path=/$1" }]
}
